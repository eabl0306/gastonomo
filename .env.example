# Copia a .env y ajusta. .env nunca se commitea.
#
# La API lee su configuracion del entorno con el prefijo GASTONOMO__ y `__` como
# separador de nivel. Todo lo que aparece aqui tiene un valor por defecto en el
# codigo (crates/infrastructure/src/config), asi que este fichero es la lista de lo
# que se puede mover, no de lo que hace falta.

# --- Postgres (pila de desarrollo de la raiz, compose.yaml) ---
POSTGRES_USER=gastonomo
POSTGRES_PASSWORD=gastonomo
POSTGRES_DB=gastonomo
POSTGRES_PORT=5432

# --- API (Rust / Salvo) ---
GASTONOMO__SERVER__HOST=0.0.0.0
GASTONOMO__SERVER__PORT=8080
GASTONOMO__DATABASE__URL=postgres://gastonomo:gastonomo@localhost:5432/gastonomo
GASTONOMO__DATABASE__MAX_CONNECTIONS=5
GASTONOMO__DATABASE__ACQUIRE_TIMEOUT_MS=3000
GASTONOMO__TELEMETRY__LOG_LEVEL=info
API_PORT=8080

# --- Autenticacion ---
# ACCESS_TOKEN_SECRET firma el access token (HS256). El valor por defecto del
# codigo es de desarrollo y el arranque lo avisa por log: CAMBIALO antes de
# cualquier despliegue, o cualquiera que lea el repositorio puede firmar un token.
GASTONOMO__AUTH__ACCESS_TOKEN_SECRET=development-only-secret-change-me
GASTONOMO__AUTH__ACCESS_TOKEN_MINUTES=15
GASTONOMO__AUTH__REFRESH_TOKEN_DAYS=30
# Enlace del correo de recuperacion. `{token}` es obligatorio.
GASTONOMO__AUTH__RESET_LINK_TEMPLATE=http://localhost:5173/reset-password?token={token}
# Limite de peticiones de login, registro y recuperacion. Es una ventana en
# memoria del proceso: con varias replicas cada una lleva su propia cuenta.
GASTONOMO__AUTH__RATE_LIMIT_MAX_REQUESTS=10
GASTONOMO__AUTH__RATE_LIMIT_WINDOW_SECONDS=60

# --- Correo saliente ---
# driver=log escribe el mensaje en el log y no envia nada: es el de desarrollo y
# el de los tests. driver=smtp envia de verdad.
GASTONOMO__MAIL__DRIVER=log
GASTONOMO__MAIL__HOST=localhost
GASTONOMO__MAIL__PORT=1025
GASTONOMO__MAIL__USERNAME=
GASTONOMO__MAIL__PASSWORD=
GASTONOMO__MAIL__FROM="Gastonomo <no-reply@gastonomo.local>"
GASTONOMO__MAIL__STARTTLS=false

# --- Tasas de cambio (Frankfurter) ---
# La API refresca las tasas dos veces al dia y las sirve desde Postgres: los
# clientes no llaman nunca a Frankfurter. Ponlo a false si el proceso no debe
# salir a internet; entonces /v1/exchange-rates responde 503 hasta que haya datos.
GASTONOMO__EXCHANGE_RATES__ENABLED=true
GASTONOMO__EXCHANGE_RATES__BASE_URL=https://api.frankfurter.dev/v2
GASTONOMO__EXCHANGE_RATES__REFRESH_HOURS_UTC=6,18
GASTONOMO__EXCHANGE_RATES__REQUEST_TIMEOUT_MS=10000
GASTONOMO__EXCHANGE_RATES__RETRY_ATTEMPTS=3
GASTONOMO__EXCHANGE_RATES__RETRY_BACKOFF_MS=2000

# --- Correo de desarrollo (Mailpit, pila de la raiz) ---
# Interfaz web en http://localhost:8025. La API le habla por SMTP en el 1025.
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Web (React / Vite) ---
# VITE_API_URL es para la web fuera de Docker. Dentro de la pila, la web habla con
# la API a traves del gateway y el valor lo pone WEB_API_URL.
VITE_API_URL=http://localhost:8080
WEB_PORT=5173

# --- Gateway de nginx (pila de la raiz) ---
# Sirve la web y la API bajo el mismo origen, que es lo que evita el problema de
# CORS: la API no manda cabeceras CORS.
GATEWAY_PORT=8090
WEB_API_URL=http://localhost:8090

# --- Pila local que imita produccion (infra/compose.smoke.yaml) ---
# La que levanta `just stack-smoke`. No es la de despliegue: compose.prod.yaml es
# el fichero que corre en el servidor, no lee nada de aqui y no publica puertos.
IMAGE_TAG=local
PUBLIC_PORT=8080

# --- Pila de solo API (apps/api/docker-compose.yml) ---
# Publica otros puertos a proposito para poder convivir con la pila de la raiz.
# La de la raiz es la que usan las recetas de `just`.
API_POSTGRES_PORT=5433
API_STANDALONE_PORT=8081
API_MAILPIT_WEB_PORT=8026
API_MAILPIT_SMTP_PORT=1026
