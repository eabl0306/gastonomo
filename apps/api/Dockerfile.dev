# syntax=docker/dockerfile:1

# Imagen de desarrollo con recarga en caliente. El contexto de build es apps/api.
#
#   docker compose -f apps/api/docker-compose.yml up api
#
# El codigo se monta como volumen; bacon recompila y reinicia el binario en
# cuanto cambia un fichero.

ARG RUST_VERSION=1.97

FROM rust:${RUST_VERSION}-slim-trixie

RUN apt-get update \
 && apt-get install --no-install-recommends --yes build-essential pkg-config curl \
 && rm -rf /var/lib/apt/lists/*

RUN cargo install cargo-watch --locked --version 8.5.3

WORKDIR /app

ENV GASTONOMO__SERVER__HOST=0.0.0.0 \
    GASTONOMO__SERVER__PORT=8080 \
    GASTONOMO__TELEMETRY__LOG_LEVEL=debug \
    CARGO_TARGET_DIR=/app/target-dev

EXPOSE 8080

# Los directorios de compilacion quedan fuera del watch: si no, cada escritura
# de cargo dispara otra recompilacion y el bucle no acaba nunca.
CMD ["cargo", "watch", "--why", \
     "--ignore", "target-dev/**", \
     "--ignore", "target/**", \
     "--exec", "run --bin gastonomo-api"]
