<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".GastonomoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gastonomo"
        android:usesCleartextTraffic="false">
        <!--
            WorkManager se configura desde GastonomoApplication, no solo. Sin quitar su
            inicializador por defecto, se arrancaria con la configuracion estandar antes de que la
            aplicacion pudiera darle su fabrica de workers.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Solo vertical. Las 14 pantallas estan disenadas para un telefono de pie: en apaisado
            las tarjetas se estiran, el teclado tapa los formularios y la tab bar se come media
            pantalla. Es una decision de diseno, no una limitacion tecnica.

            Lint protesta por dos cosas y las dos se aceptan a sabiendas. `LockedOrientationActivity`
            pide no fijar la orientacion para que la aplicacion sirva en Chrome OS, que no es un
            destino de esta aplicacion. `DiscouragedApi` avisa de que a partir de Android 16 el
            sistema ignora la orientacion fija en pantallas grandes: correcto, y no cambia nada
            aqui, porque en un telefono si se respeta y un telefono es lo unico que hay disenado.
            Si algun dia hay version para tablet, esto se cae solo y habra que disenar el apaisado.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Gastonomo"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>