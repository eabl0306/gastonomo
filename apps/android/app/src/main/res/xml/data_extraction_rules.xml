<?xml version="1.0" encoding="utf-8"?><!--
    Android 12 y posteriores. El porque esta en el ADR 0018 y en backup_rules.xml.

    Se excluye tambien la transferencia entre dispositivos, que android:allowBackup="false" no
    apaga por su cuenta.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
