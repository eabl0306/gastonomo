<?xml version="1.0" encoding="utf-8"?>
<!--
  Politica de red de debug: texto claro SOLO para la API local. 10.0.2.2 es el host de la
  maquina visto desde el emulador; 127.0.0.1 y localhost valen cuando se usa
  "adb reverse" contra un telefono. Cualquier otro destino sigue exigiendo https, asi que
  una llamada por http a un servidor real falla igual que en release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
