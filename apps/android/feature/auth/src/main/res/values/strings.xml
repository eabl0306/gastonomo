<?xml version="1.0" encoding="utf-8"?>
<!--
  Textos de las cuatro pantallas de entrada: Login, Registro, Recuperar contrasena y
  desbloqueo con PIN o huella. Copiados del prototipo y del handoff.

  Este es el idioma por defecto (es-CO); la traduccion esta en values-en. Los textos que
  comparten varias pantallas no estan aqui: viven en :core:designsystem y se leen por
  GastonomoStrings.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="es">

    <!-- Campos, compartidos por las tres pantallas con formulario -->
    <string name="auth_field_name">Nombre</string>
    <string name="auth_field_name_placeholder">Cómo te llamas</string>
    <string name="auth_field_email">Correo</string>
    <string name="auth_field_email_placeholder">tu@correo.com</string>
    <string name="auth_field_password">Contraseña</string>
    <string name="auth_field_password_placeholder" translatable="false">••••••••</string>
    <string name="auth_show_password">Mostrar la contraseña</string>
    <string name="auth_hide_password">Ocultar la contraseña</string>

    <!-- 1. Login -->
    <string name="auth_login_title">Bienvenido de nuevo</string>
    <string name="auth_login_subtitle">Entra para ver tus cuentas sincronizadas.</string>
    <string name="auth_login_forgot">¿Olvidaste tu contraseña?</string>
    <string name="auth_login_submit">Entrar</string>
    <string name="auth_divider_or">o</string>
    <string name="auth_login_biometrics">Entrar con huella o PIN</string>
    <string name="auth_login_no_account">¿No tienes cuenta?</string>
    <string name="auth_login_register">Regístrate</string>

    <!-- 2. Registro -->
    <string name="auth_register_title">Crea tu cuenta</string>
    <string name="auth_register_subtitle">Tus movimientos y préstamos se guardan en la nube y se sincronizan entre tus dispositivos.</string>
    <string name="auth_register_password_placeholder">Mínimo 8 caracteres</string>
    <string name="auth_register_terms">Acepto los términos de uso y la política de privacidad.</string>
    <string name="auth_register_submit">Crear cuenta</string>
    <string name="auth_register_have_account">¿Ya tienes cuenta?</string>
    <string name="auth_register_login">Inicia sesión</string>
    <string name="auth_register_toast">Cuenta creada. Tus datos se sincronizan.</string>
    <string name="auth_strength_label">Fuerza de la contraseña: %1$s</string>
    <string name="auth_strength_empty">Mínimo 8 caracteres</string>
    <string name="auth_strength_very_short">Muy corta</string>
    <string name="auth_strength_almost">Casi</string>
    <string name="auth_strength_good">Buena</string>
    <string name="auth_strength_strong">Segura</string>

    <!-- 3. Recuperar contrasena -->
    <string name="auth_forgot_title">Recupera tu contraseña</string>
    <string name="auth_forgot_subtitle">Escribe el correo de tu cuenta y te enviaremos un enlace para crear una nueva.</string>
    <string name="auth_forgot_submit">Enviar enlace</string>
    <string name="auth_forgot_sent_title">Revisa tu correo</string>
    <string name="auth_forgot_sent_body">Enviamos un enlace a %1$s. Caduca en 30 minutos.</string>
    <string name="auth_forgot_email_fallback">tu correo</string>
    <string name="auth_forgot_back_to_login">Volver a iniciar sesión</string>
    <string name="auth_forgot_resend">¿No llegó? Reenviar</string>
    <string name="auth_forgot_resent_toast">Enlace reenviado</string>

    <!-- 4. PIN y huella -->
    <string name="auth_unlock_greeting">Hola, %1$s</string>
    <string name="auth_unlock_prompt">Ingresa tu PIN o usa tu huella</string>
    <string name="auth_unlock_use_password">Usar contraseña</string>
    <plurals name="auth_unlock_dots">
        <item quantity="one">PIN de cuatro dígitos, %1$d escrito</item>
        <!-- El CLDR moderno pide "many" en espanol para los numeros compactos. -->
        <item quantity="many">PIN de cuatro dígitos, %1$d escritos</item>
        <item quantity="other">PIN de cuatro dígitos, %1$d escritos</item>
    </plurals>
    <string name="auth_unlock_fingerprint">Entrar con huella</string>
    <string name="auth_unlock_backspace">Borrar el último dígito</string>
    <string name="auth_unlock_wrong_pin">PIN incorrecto. Inténtalo de nuevo.</string>
    <plurals name="auth_unlock_attempts_left">
        <item quantity="one">PIN incorrecto. Te queda %1$d intento.</item>
        <!-- El CLDR moderno pide "many" en espanol para los numeros compactos. -->
        <item quantity="many">PIN incorrecto. Te quedan %1$d intentos.</item>
        <item quantity="other">PIN incorrecto. Te quedan %1$d intentos.</item>
    </plurals>
    <string name="auth_unlock_locked_out">Demasiados intentos. Entra con tu contraseña.</string>
    <string name="auth_unlock_biometrics_failed">No se pudo leer la huella. Usa tu PIN.</string>

    <!-- Errores de validacion, los que no manda la API -->
    <string name="auth_error_name_required">Escribe tu nombre.</string>
    <string name="auth_error_email_required">Escribe tu correo.</string>
    <string name="auth_error_email_invalid">Ese correo no es válido.</string>
    <string name="auth_error_password_required">Escribe tu contraseña.</string>
    <string name="auth_error_password_too_short">La contraseña necesita 8 caracteres o más.</string>
    <string name="auth_error_terms_required">Tienes que aceptar los términos para continuar.</string>
    <string name="auth_error_invalid_credentials">Correo o contraseña incorrectos.</string>
    <string name="auth_error_too_many_requests">Demasiados intentos. Espera un minuto y vuelve a probar.</string>
    <string name="auth_error_conflict">No se pudo completar. Revisa los datos.</string>

</resources>
