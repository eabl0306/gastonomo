# syntax=docker/dockerfile:1
# Servidor de desarrollo con HMR. Contexto de build: la RAIZ del repo.
#   docker build -f apps/web/Dockerfile.dev -t gastonomo-web-dev .
FROM node:26-alpine
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY tools/checks/package.json tools/checks/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter @gastonomo/web...

COPY packages/ packages/
COPY apps/web/ apps/web/

ENV VITE_API_URL=http://localhost:8080
EXPOSE 5173
# host 0.0.0.0 para que el servidor sea accesible desde fuera del contenedor.
CMD ["pnpm", "--filter", "@gastonomo/web", "dev", "--host", "0.0.0.0", "--port", "5173"]
